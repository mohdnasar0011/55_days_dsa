class Solution {
    public double findMaxAverage(int[] nums, int k) {
        
        if (nums.length == 1) {
            return nums[0];
        }
        int sum = 0;

        for (int i = 0; i < k; i++) {
            sum += nums[i];
        }

        double maxSum = sum;
        int startIndex = 0;
        int endIndex = k;
        while (endIndex < nums.length) {
            sum -= nums[startIndex];
            startIndex++;
            sum += nums[endIndex];
            endIndex++;

            maxSum = Math.max(maxSum, sum);

        }

        return maxSum / k;

    }
